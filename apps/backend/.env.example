# Port for Express server
PORT=5001
NODE_ENV=development

# Mock SSE Dev Server for Content Strategist (blocked when NODE_ENV=production)
ENABLE_MOCK_CHAT="false"
MOCK_CHAT_SPEED="normal" # instant | normal | slow | timeout

# Number of trusted reverse-proxy hops (Railway direct edge defaults to 1).
TRUST_PROXY_HOPS="1"

# Neon Database Connection
DATABASE_URL="postgres://user:password@endpoint-pooler.neon.tech/neondb?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgres://user:password@endpoint.neon.tech/neondb?connect_timeout=15"

# Clerk Secret Key (Get from https://dashboard.clerk.com)
CLERK_SECRET_KEY="your-clerk-secret-key"
CLERK_WEBHOOK_SECRET="your-clerk-webhook-secret"

# Active AI provider (gemini | groq | openrouter)
ACTIVE_AI_PROVIDER="gemini"

# Gemini API Key (primary provider)
GEMINI_API_KEY="your-gemini-api-key"

# Gemini Copilot / Strategist Wizard model and output controls
GEMINI_COPILOT_MODEL="gemini-3.1-flash-lite"
GEMINI_RESEARCH_MODEL="gemini-3.1-pro-preview"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_SEO_MODEL="gemini-3.1-flash-lite"
GEMINI_COPILOT_FAST_MAX_TOKENS="1200"
GEMINI_COPILOT_FAST_TEMPERATURE="0.35"
GEMINI_COPILOT_FAST_FALLBACK_THRESHOLD="900"
GEMINI_COPILOT_FAST_FALLBACK_MAX_TOKENS="360"

# Gemini inference tier. Keep Standard for latency-sensitive production traffic.
# Use Flex for latency-tolerant staging/smoke tests at 50% token cost.
# Flex is best-effort, can take minutes, and never auto-falls back to Standard.
GEMINI_SERVICE_TIER="standard"
GEMINI_FLEX_TIMEOUT_MS="900000"
GEMINI_FLEX_MAX_RETRIES="2"
GEMINI_FLEX_RETRY_BASE_DELAY_MS="5000"
# Optional staging guard: removes Google Search tools and disables Deep Research.
# Tool charges are separate from the Flex token discount.
GEMINI_DISABLE_GROUNDING_FOR_TESTS="false"

# Groq API Key (optional provider)
GROQ_API_KEY="your-groq-api-key"

# OpenRouter API Key (unified provider for cross-provider model access)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4.1-mini"
OPENROUTER_SEO_MODEL="openai/gpt-4.1-mini"
OPENROUTER_HTTP_REFERER="https://envoyou.com"
OPENROUTER_APP_TITLE="Envoyou AI"

# AI cost analytics. Token usage comes from providers; IDR cost is estimated.
AI_COST_USD_TO_IDR="18000"

# Comma-separated Clerk user IDs allowed to access owner-only internal tools.
OWNER_USER_IDS="user_your_owner_clerk_id"

# Optional Zoho Desk validation for manual billing adjustments.
ZOHO_DESK_ENABLED="false"
ZOHO_DESK_CLIENT_ID=""
ZOHO_DESK_CLIENT_SECRET=""
ZOHO_DESK_REFRESH_TOKEN=""
ZOHO_DESK_ORG_ID=""
ZOHO_DESK_DEPARTMENT_ID=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_DESK_API_URL="https://desk.zoho.com/api/v1"

# Edge Config (Feature Flags) Server Credentials
EDGE_CONFIG=""
EDGE_CONFIG_ID=""
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""

# Export Pipeline Settings
BLOG_IMPORT_SHARED_SECRET=""
BLOG_BACKEND_API_URL="your-blog-backend-api-url"

# Encrypts tenant CMS credentials at rest.
CMS_CREDENTIALS_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Shared secret token for public stats integration
PUBLIC_STATS_TOKEN=""

# Payment gateway configuration
PAYMENT_PROVIDER="midtrans"
PAYMENT_USD_TO_IDR_RATE="18000"
PAYMENT_TAX_LABEL="Includes 11% VAT (PPN). A detailed tax invoice will be issued upon successful payment."

# Midtrans Snapchat Credentials
MIDTRANS_SERVER_KEY="SB-Mid-server-your-sandbox-server-key"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_ENABLE_SIMULATOR="false"
MIDTRANS_SIMULATOR_SECRET="replace-with-a-long-random-local-secret"

REDIS_URL=

# Distributed HTTP rate limiter. Keep fail-open disabled in production.
RATE_LIMIT_REDIS_PREFIX="eai:rate-limit"
RATE_LIMIT_FAIL_OPEN="false"
RATE_LIMIT_REDIS_TIMEOUT_MS="2500"

# Outbound HTTP policy for user-supplied URL scraping.
# Ports default to 80,443. Leave ALLOWED_HOSTS empty to permit any public host.
# Host rules accept exact names or wildcard subdomains such as *.example.com.
OUTBOUND_HTTP_ALLOWED_PORTS="80,443"
OUTBOUND_HTTP_ALLOWED_HOSTS=""
OUTBOUND_HTTP_BLOCKED_HOSTS=""
OUTBOUND_HTTP_TIMEOUT_MS="8000"
OUTBOUND_HTTP_MAX_RESPONSE_BYTES="2097152"

# Cloudflare R2 Object Storage Credentials
CLOUDFLARE_R2_ACCOUNT_ID="your-r2-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="eai-insight"
CLOUDFLARE_R2_PUBLIC_URL="https://your-public-r2-domain.com"

# Mailgun Settings (For sending custom invitation and transaction emails)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL="Brand <noreply@example.com>"
